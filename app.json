{
  "expo": {
    "name": "Bat",
    "slug": "bat",
    "version": "1.0.3",
    "orientation": "portrait",
    "icon": "./assets/ios_icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "buildNumber": "60",
      "supportsTablet": true,
      "bundleIdentifier": "com.batman.bat",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true
        },
        "NSCameraUsageDescription": "학습 자료를 촬영해 OCR로 텍스트를 인식하고 학습 콘텐츠를 생성하기 위해 카메라 접근 권한을 요청합니다. 촬영한 이미지는 학습 자료 분석과 복습 생성에만 사용됩니다.",
        "NSPhotoLibraryUsageDescription": "사진 보관함의 학습 자료 이미지를 선택해 OCR로 텍스트를 인식하고 학습 콘텐츠를 생성하기 위해 사진 접근 권한을 요청합니다. 선택한 이미지는 학습 자료 분석과 복습 생성에만 사용됩니다.",
        "UIBackgroundModes": [
          "fetch",
          "remote-notification"
        ],
        "LSApplicationQueriesSchemes": [
          "kakaokompassauth",
          "kakaolink",
          "kakaoplus",
          "kakaonavi-sdk"
        ],
        "CFBundleURLTypes": [
          {
            "CFBundleURLSchemes": [
              "kakaoe365864e7fe56bb2f65a88afd873b33d"
            ]
          }
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.batman.bat",
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE"
      ]
    },
    "plugins": [
      "expo-notifications",
      "expo-apple-authentication",
      "react-native-iap",
      [
        "expo-build-properties",
        {
          "ios": {
            "useHooks": true
          }
        }
      ]
    ],
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "d29b2e3f-f993-4e0e-b46a-305ad06acbd8"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/d29b2e3f-f993-4e0e-b46a-305ad06acbd8"
    },
    "owner": "batman-team"
  }
}
